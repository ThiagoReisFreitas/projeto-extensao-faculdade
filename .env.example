# Copie para .env e preencha. O `.env` NAO vai pro git.
# Atalho: `./ops/gen-env.sh` gera este arquivo com segredos aleatorios.
# Valores sem espacos e sem aspas (os scripts de ops fazem `. ./.env`).

# --- Postgres ---
POSTGRES_USER=pensador
POSTGRES_PASSWORD=            # obrigatorio: senha forte (ex.: openssl rand -base64 24)
POSTGRES_DB=pensador
# host = nome do servico no compose. Use a MESMA senha de POSTGRES_PASSWORD.
DATABASE_URL=postgres://pensador:SENHA_AQUI@db:5432/pensador

# --- Auth ---
JWT_SECRET=                   # obrigatorio: openssl rand -hex 32  (>= 24 chars, sem valor de exemplo)
JWT_EXPIRES=12h

# --- Dono criado no primeiro boot (se nao houver nenhum usuario) ---
ADMIN_NOME=Dono
ADMIN_EMAIL=dono@opensador.local
ADMIN_SENHA=                  # obrigatorio: >= 8 chars, diferente de "trocar123"

# --- Uploads ---
UPLOAD_MAX_BYTES=2097152      # trava pos-compressao no client

# --- URL publica (usada no link de redefinicao de senha) ---
APP_URL=http://localhost:8080

# --- E-mail (opcional). Com RESEND_API_KEY setado, o "Esqueci a senha" liga sozinho. ---
# Crie a key em resend.com (free tier). Sem isso, o reset por e-mail fica desligado
# e a recuperacao e o Dono redefinir em Cadastros (ver ops/README.md).
# RESEND_API_KEY=
# MAIL_FROM=O Pensador <no-reply@seudominio.com>

# --- Dev com `npm run dev` (Vite em :5173 chamando a API em :3000) ---
# CORS_ORIGIN=http://localhost:5173

# --- ops/ (opcional): backup externo e alerta ---
# RCLONE_REMOTE=gdrive:pensador
# BACKUP_GPG_RECIPIENT=       # se setado, cifra o dump com gpg antes de sair do disco
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT=
